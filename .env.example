# ── GitHub ──────────────────────────────────────────────────────
# Токен для чтения закреплённых репозиториев (только публичные данные).
# Достаточно classic PAT вообще без скобов: https://github.com/settings/tokens/new
# Локально: .env.local (или .env). На сервере рядом с docker-compose.yml: .env
GITHUB_TOKEN=

# Владелец профиля, чьи закреплённые репозитории показывает сайт.
GITHUB_USERNAME=Sh1yden
